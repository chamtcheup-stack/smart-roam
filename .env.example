# ════════════════════════════════════════════════════════════
# Smart Roam — variables d'environnement du backend
# Copier ce fichier en .env puis renseigner les valeurs.
# Ne JAMAIS committer le fichier .env.
# ════════════════════════════════════════════════════════════

# ── Serveur ─────────────────────────────────────────────────
PORT=3000
# development | production | test
NODE_ENV=development
# error | warn | info | debug | silent
LOG_LEVEL=info
# texte (lisible) | json (une ligne JSON par évènement, pour un outil de supervision)
LOG_FORMAT=texte
# Derrière un reverse proxy (Nginx, load balancer…) : nombre de proxys
# de confiance (ex. 1) ou "loopback". Laisser false en accès direct.
TRUST_PROXY=false
# Origines autorisées par CORS, séparées par des virgules.
# Vide en développement = http://localhost:5173 et http://127.0.0.1:5173.
CORS_ORIGINS=

# ── Supabase ────────────────────────────────────────────────
# Clé service_role côté serveur uniquement : ne jamais l'exposer au frontend.
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_KEY=
# Délai maximal d'une requête vers Supabase (ms) : au-delà, réponse 503.
SUPABASE_TIMEOUT_MS=8000

# ── Limitations par adresse IP ──────────────────────────────
# Les opérateurs mobiles partagent une même IP publique entre des milliers
# d'abonnés (CGNAT) : seuils élevés, la protection fine se fait par compte.
LIMITE_CONNEXIONS_IP_15MIN=300
# Seuls les ÉCHECS de connexion sont comptés ici.
LIMITE_ECHECS_CONNEXION_IP_15MIN=100
LIMITE_INSCRIPTIONS_IP_HEURE=100
WAF_MAX_REQUETES_SECONDE=100

# ── Authentification ────────────────────────────────────────
# Secret de signature des JWT (32 caractères minimum, OBLIGATOIRE en production).
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Clé des appels machine-à-machine (plateforme SIP, back-office…),
# transmise dans l'en-tête x-api-key. Vide = désactivé.
SERVICE_API_KEY=
# Identifiants (user_id) des administrateurs, séparés par des virgules.
ADMIN_USER_IDS=
# Poivre secret ajouté au hachage des PIN (fortement recommandé en production).
PIN_PEPPER=

# ── Chiffrement AES-256-GCM (algo 09) ───────────────────────
# Trousseau de clés versionnées "version:cléHex64", séparées par des virgules.
# La dernière est la clé courante ; les précédentes servent au déchiffrement.
# Générer une clé : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEYS=

# ── Certificate pinning des partenaires (algo 12) ───────────
# Empreintes SHA-256 (base64) des clés publiques autorisées, séparées par des virgules.
PARTNER_TLS_PINS=
# Date d'expiration des empreintes (AAAA-MM-JJ) : au-delà, les appels sont refusés.
PARTNER_TLS_PINS_EXPIRES_AT=

# ── Tâches planifiées ───────────────────────────────────────
# Intervalle du JIT Stock Manager en minutes (0 = désactivé).
JIT_INTERVAL_MINUTES=0
# Maintenance en minutes (0 = désactivé) : clôture des voyages échus,
# expiration des forfaits eSIM, purge des sessions expirées.
MAINTENANCE_INTERVAL_MINUTES=60
# Pool de threads de libuv (hachage des PIN) : 16 par défaut si absent.
# UV_THREADPOOL_SIZE=16

# ── Change de devises (algo 17) ─────────────────────────────
# Taux de référence quotidiens de la BCE pour les paires hors parité fixe
# EUR/XAF/XOF (true par défaut, false pour travailler hors ligne).
ECB_RATES_ENABLED=true

# ── eSIM ────────────────────────────────────────────────────
# Identifiant émetteur inséré dans les ICCID générés (2 chiffres).
ICCID_ISSUER_ID=01
